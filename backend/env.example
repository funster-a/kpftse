# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID менеджера (куда отправлять заявки)
# Можно узнать через @userinfobot или @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here

# Port для сервера (опционально, по умолчанию 3000)
PORT=3000

